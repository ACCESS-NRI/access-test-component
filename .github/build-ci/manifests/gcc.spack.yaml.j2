spack:
  specs:
  - group: compiler
    specs:
    - gcc@{{ gcc_compiler_ver }}
  - group: componenets
    needs:
    - compiler
    specs:
    - access-test-component @git.{{ ref }}
  packages:
    all:
      require:
      - '%access_gcc'
      - 'target={{ target }}'
  concretizer:
    unify: false
  view: false
